# Development image: same as Dockerfile, but the kubocd CLI comes from the build
# context instead of a published release.
#
# The server shells out to `kubocd dump package` to groom a package schema. Only
# a kubocd carrying the unified Connections model emits the
# x-kubocd-connection-ref marker the server reads, so a published release cannot
# be used while that model is unmerged.
ARG GO_VERSION=1.25

FROM --platform=$BUILDPLATFORM golang:${GO_VERSION} AS go-build
ARG TARGETOS=linux
ARG TARGETARCH
WORKDIR /workspace/okdp-server
COPY go.* ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags="-s -w" -o /okdp-server ./cmd/server

FROM alpine:3.21
RUN apk --no-cache add ca-certificates && update-ca-certificates
COPY --from=go-build /okdp-server /usr/local/bin/okdp-server
COPY kubocd-local /usr/local/bin/kubocd
ENV HOME=/tmp
USER 65534:65534
EXPOSE 8093
ENTRYPOINT ["okdp-server"]
