{
  "name": "mysql",
  "interface": "database-server",
  "displayName": "MySQL",
  "description": "MySQL or MariaDB database server.",
  "icon": "pi pi-database",
  "category": "database",
  "external": true,
  "fields": [
    {
      "name": "engine",
      "label": "Engine",
      "type": "enum",
      "required": true,
      "default": "mysql",
      "options": [
        "mysql"
      ],
      "help": "Read by consuming packages to build their JDBC URL. Fixed for this type."
    },
    {
      "name": "driver",
      "label": "JDBC driver",
      "type": "enum",
      "required": true,
      "default": "com.mysql.cj.jdbc.Driver",
      "options": [
        "com.mysql.cj.jdbc.Driver",
        "org.mariadb.jdbc.Driver"
      ],
      "help": "Driver class name, read by packages that configure a JDBC datasource. MariaDB servers usually take the MariaDB driver."
    },
    {
      "name": "host",
      "label": "Host",
      "type": "string",
      "required": true,
      "placeholder": "mysql.example.com"
    },
    {
      "name": "port",
      "label": "Port",
      "type": "number",
      "required": true,
      "default": 3306,
      "min": 1,
      "max": 65535
    },
    {
      "name": "dbName",
      "label": "Database",
      "type": "string",
      "required": true,
      "placeholder": "analytics"
    },
    {
      "name": "username",
      "label": "User",
      "type": "string",
      "required": true,
      "secret": true,
      "help": "Stored in the credentials Secret, under the username key, as the database-server contract expects."
    },
    {
      "name": "password",
      "label": "Password",
      "type": "string",
      "required": true,
      "secret": true
    },
    {
      "name": "tls",
      "label": "TLS",
      "type": "enum",
      "required": true,
      "default": "preferred",
      "options": [
        "false",
        "preferred",
        "true",
        "skip-verify"
      ],
      "help": "'preferred' uses TLS when the server offers it, 'true' requires it and validates the certificate."
    }
  ],
  "providers": {
    "services": [
      "mysql",
      "mariadb"
    ],
    "portNames": [
      "mysql",
      "mariadb",
      "tcp-mysql"
    ],
    "defaultPort": 3306
  },
  "usage": {
    "uri": "mysql://${MYSQL_USER}:${MYSQL_PWD}@{host}:{port}/{dbName}",
    "uriLabel": "Connection URI",
    "env": [
      {
        "name": "MYSQL_HOST",
        "from": "host"
      },
      {
        "name": "MYSQL_TCP_PORT",
        "from": "port"
      },
      {
        "name": "MYSQL_DATABASE",
        "from": "dbName"
      },
      {
        "name": "MYSQL_USER",
        "secretField": "username"
      },
      {
        "name": "MYSQL_PWD",
        "secretField": "password"
      }
    ]
  }
}
