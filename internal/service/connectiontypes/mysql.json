{
  "name": "mysql",
  "displayName": "MySQL / MariaDB",
  "description": "MySQL or MariaDB database server.",
  "icon": "pi pi-database",
  "category": "database",
  "external": true,
  "fields": [
    {
      "name": "host",
      "label": "Host",
      "type": "string",
      "required": true,
      "placeholder": "mysql.example.com"
    },
    {
      "name": "port",
      "label": "Port",
      "type": "number",
      "required": true,
      "default": 3306,
      "min": 1,
      "max": 65535
    },
    {
      "name": "database",
      "label": "Database",
      "type": "string",
      "required": true
    },
    {
      "name": "user",
      "label": "User",
      "type": "string",
      "required": true
    },
    {
      "name": "password",
      "label": "Password",
      "type": "string",
      "required": true,
      "secret": true
    },
    {
      "name": "tls",
      "label": "TLS",
      "type": "enum",
      "required": true,
      "default": "preferred",
      "options": ["false", "preferred", "true", "skip-verify"],
      "help": "'preferred' uses TLS when the server offers it; 'true' requires it and validates the certificate."
    }
  ],
  "providers": {
    "services": ["mysql", "mariadb"],
    "portNames": ["mysql", "mariadb", "tcp-mysql"],
    "defaultPort": 3306
  }
}
