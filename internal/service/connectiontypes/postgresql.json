{
  "name": "postgresql",
  "interface": "database-server",
  "displayName": "PostgreSQL",
  "description": "PostgreSQL database server.",
  "icon": "pi pi-database",
  "category": "database",
  "external": true,
  "fields": [
    {
      "name": "engine",
      "label": "Engine",
      "type": "enum",
      "required": true,
      "default": "postgresql",
      "options": [
        "postgresql"
      ],
      "help": "Read by consuming packages to build their JDBC URL. Fixed for this type."
    },
    {
      "name": "driver",
      "label": "JDBC driver",
      "type": "enum",
      "required": true,
      "default": "org.postgresql.Driver",
      "options": [
        "org.postgresql.Driver"
      ],
      "help": "Driver class name, read by packages that configure a JDBC datasource."
    },
    {
      "name": "host",
      "label": "Host",
      "type": "string",
      "required": true,
      "placeholder": "postgres.example.com"
    },
    {
      "name": "port",
      "label": "Port",
      "type": "number",
      "required": true,
      "default": 5432,
      "min": 1,
      "max": 65535
    },
    {
      "name": "dbName",
      "label": "Database",
      "type": "string",
      "required": true,
      "placeholder": "analytics"
    },
    {
      "name": "username",
      "label": "User",
      "type": "string",
      "required": true,
      "secret": true,
      "help": "Stored in the credentials Secret, under the username key, as the database-server contract expects."
    },
    {
      "name": "password",
      "label": "Password",
      "type": "string",
      "required": true,
      "secret": true
    },
    {
      "name": "sslMode",
      "label": "SSL mode",
      "type": "enum",
      "required": true,
      "default": "prefer",
      "options": [
        "prefer",
        "require",
        "verify-ca",
        "verify-full",
        "disable"
      ],
      "help": "'prefer' tries TLS and connects in clear text if the server refuses it, the safe default for a server you do not control. 'require' encrypts without validating the certificate, use 'verify-full' when the server presents one your cluster trusts."
    }
  ],
  "providers": {
    "services": [
      "postgresql",
      "postgres"
    ],
    "portNames": [
      "postgresql",
      "postgres",
      "tcp-postgresql"
    ],
    "defaultPort": 5432
  },
  "usage": {
    "uri": "postgresql://${PGUSER}:${PGPASSWORD}@{host}:{port}/{dbName}?sslmode={sslMode}",
    "uriLabel": "Connection URI",
    "env": [
      {
        "name": "PGHOST",
        "from": "host"
      },
      {
        "name": "PGPORT",
        "from": "port"
      },
      {
        "name": "PGDATABASE",
        "from": "dbName"
      },
      {
        "name": "PGSSLMODE",
        "from": "sslMode"
      },
      {
        "name": "PGUSER",
        "secretField": "username"
      },
      {
        "name": "PGPASSWORD",
        "secretField": "password"
      }
    ]
  }
}
